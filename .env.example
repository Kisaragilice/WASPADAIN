# WASPADAIN environment (pengembangan lokal)
# Salin menjadi .env untuk pengembangan lokal. Jangan commit nilai asli.
#
# Port host default memakai 7481/7482 (rentang 7000-9999 yang jarang dipakai)
# agar tidak bentrok dengan layanan umum seperti 3000, 5432, 8080, atau 9000.
# Ubah bila port tersebut sudah dipakai di mesin Anda.
DATABASE_URL="postgresql://waspadain:waspadain@localhost:7482/waspadain?schema=public"

# Dipakai oleh docker compose untuk container database.
POSTGRES_USER="waspadain"
POSTGRES_PASSWORD="waspadain"
POSTGRES_DB="waspadain"
DB_PORT="7482"

# Port host aplikasi saat menjalankan stack Docker penuh.
APP_HOST="0.0.0.0"
APP_PORT="7481"

# Wajib. Produksi menolak nilai contoh ini dan mewajibkan >= 32 karakter acak.
# Buat dengan: openssl rand -hex 32
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-aman"

# URL publik aplikasi. Wajib di produksi; dipakai untuk tautan reset password.
# `npm run dev` berjalan di port 3000. APP_PORT di atas hanya dipakai saat
# menjalankan stack Docker penuh (default 7481), bukan oleh `npm run dev`.
APP_URL="http://localhost:3000"

# Opsional. Email reset password hanya dikirim bila API key tersedia.
# Sender harus domain yang sudah diverifikasi di dashboard Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="WASPADAIN <admin@domain.id>"
# Opsional: tujuan default saat menjalankan `npm run email:test` tanpa argumen.
RESEND_TEST_TO=""

# Opsional, hanya untuk pengembangan: seed akun & aktivitas demo.
# Tidak berjalan di production. Jalankan dengan: npm run db:seed:demo
SEED_DEMO_DATA="false"

# Bootstrap admin dijalankan manual, bukan lewat seed:
#   ADMIN_EMAIL="admin@waspadain.id" ADMIN_PASSWORD="..." npm run admin:create
# Rotasi kata sandi admin yang sudah ada:
#   ADMIN_EMAIL="admin@waspadain.id" ADMIN_PASSWORD="..." npm run admin:reset
# Hapus semua akun termasuk admin (backup JSON otomatis):
#   npm run accounts:reset -- --yes
# Uji Resend dari terminal:
#   npm run email:test -- alamat-anda@domain.id
