# WASPADAIN — konfigurasi deployment Docker
#
#   cp .env.docker.example .env.docker
#   # isi nilai di bawah, lalu:
#   docker compose --env-file .env.docker up -d --build
#
# Compose tidak membaca .env.docker otomatis, jadi flag --env-file wajib
# disertakan setiap kali menjalankan compose. Untuk perintah yang lebih pendek:
#   export COMPOSE_ENV_FILES=.env.docker
#   docker compose up -d --build
#
# Nilai di bawah adalah PLACEHOLDER. Ganti sebelum deploy.

# Port host aplikasi. Port internal Next.js selalu 3000.
# Default 7481 berada di rentang 7000-9999 yang jarang dipakai sehingga kecil
# kemungkinan bentrok dengan layanan lain di server.
# APP_HOST=0.0.0.0 membuka ke semua interface. Set 127.0.0.1 bila aplikasi
# berada di belakang reverse proxy (nginx/Caddy/Traefik) pada host yang sama.
APP_HOST=0.0.0.0
APP_PORT=7481

# URL publik aplikasi. WAJIB berupa URL https untuk produksi.
# Cookie sesi memakai prefix __Host- + Secure, jadi login hanya bekerja
# lewat HTTPS. Pasang reverse proxy (mis. nginx + certbot) sebelum go-live.
APP_URL="https://domain-anda.id"

# Wajib: nilai acak minimal 32 karakter. Buat dengan:
#   openssl rand -hex 32
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-aman"

# Kredensial PostgreSQL. Dipakai container db dan disusun menjadi DATABASE_URL.
# Gunakan karakter URL-safe (mis. hasil `openssl rand -hex 32`) agar
# DATABASE_URL tidak rusak oleh karakter seperti @ : / % #.
POSTGRES_USER="waspadain"
POSTGRES_PASSWORD="ganti-dengan-password-db-yang-kuat"
POSTGRES_DB="waspadain"
# Port loopback host untuk database (tidak terekspos ke jaringan publik).
# Default 7482, juga di rentang 7000-9999 yang jarang dipakai.
DB_PORT=7482

# Zona waktu container untuk log dan timestamp aplikasi.
TZ=Asia/Jakarta

# Opsional: pakai database eksternal/terkelola. DATABASE_URL di compose
# disusun dari POSTGRES_* di atas; untuk database eksternal, buat
# docker-compose.override.yml berisi:
#   services:
#     app:
#       environment:
#         DATABASE_URL: "postgresql://user:password@host:5432/db?schema=public&sslmode=require"

# Opsional: email reset password via Resend. Kosongkan bila tidak dipakai;
# aplikasi tetap berjalan dan tidak mengirim email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Opsional: tujuan default `docker compose ... run --rm app npm run email:test`.
RESEND_TEST_TO=""

# Opsional: bootstrap admin dijalankan manual, bukan otomatis saat start.
# Jangan simpan kredensial ini di .env.docker produksi setelah provisioning.
# ADMIN_EMAIL="admin@waspadain.id"
# ADMIN_PASSWORD="isi-saat-bootstrap-saja"

# PERINTAH OPERASIONAL (jalankan di root project)
# Start/upgrade:   docker compose --env-file .env.docker up -d --build
# Status:          docker compose --env-file .env.docker ps
# Log:             docker compose --env-file .env.docker logs -f app
# Stop:            docker compose --env-file .env.docker stop
# Hapus container: docker compose --env-file .env.docker down
# Admin baru:      docker compose --env-file .env.docker run --rm \
#                    -e ADMIN_EMAIL=admin@domain-anda.id \
#                    -e ADMIN_PASSWORD='kata-sandi-kuat' \
#                    app npm run admin:create
# Rotasi admin:    docker compose --env-file .env.docker run --rm \
#                    -e ADMIN_EMAIL=admin@domain-anda.id \
#                    -e ADMIN_PASSWORD='kata-sandi-baru' \
#                    app npm run admin:reset
# Reset akun:      docker compose --env-file .env.docker run --rm \
#                    app npm run accounts:reset -- --yes
# Tes Resend:      docker compose --env-file .env.docker run --rm \
#                    app npm run email:test -- alamat-anda@domain.id

# CATATAN PENTING
# - POSTGRES_PASSWORD hanya dipakai saat volume database dibuat pertama kali.
#   Mengubahnya setelah volume ada TIDAK mengubah password di dalam Postgres
#   dan membuat container app gagal dengan error P1000. Untuk instalasi baru:
#     docker compose --env-file .env.docker down -v   # HAPUS semua data DB
#   Untuk data yang sudah ada, ubah password lewat psql, bukan lewat .env.
# - Container app menjalankan `prisma migrate deploy` dan seed katalog setiap
#   boot. Keduanya idempoten. Seed demo dan admin tidak otomatis.
# - Health check app: GET /api/health (cek koneksi database).
